# Copy to .env.local for local development. NEVER commit .env.local.
# Leave both unset to run the site exactly as it is today (no accounts, progress kept in the browser).

# Project URL from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLIC anon / publishable key only. It is sent to browsers and is safe because row-level security
# protects the data. NEVER put the service_role key (or any "secret" key) in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Server-only secrets (e.g. the service_role key for seeding) must NOT be prefixed NEXT_PUBLIC_ and are
# not needed by the site. Keep them in your shell or CI secret store, not in files.
